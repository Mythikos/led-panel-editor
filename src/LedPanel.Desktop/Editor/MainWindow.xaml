<Window x:Class="LedPanel.Desktop.Editor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LedPanel.Desktop.Editor" xmlns:preview="clr-namespace:LedPanel.Desktop.Preview" Style="{StaticResource {x:Type Window}}" Title="Panel editor" Width="1080" Height="980" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Window.Resources><local:EntryOptionEnabledConverter x:Key="EntryEnabled" /></Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="30,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <Button x:Name="ReloadButton" Content="Reload panel" Command="{Binding ReloadCommand}" Margin="0,0,10,0" AutomationProperties.AutomationId="Reload">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Quiet}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style></Button.Style>
          </Button>
          <Button x:Name="ConnectionButton" Content="{Binding ConnectLabel}" Command="{Binding ConnectionCommand}" AutomationProperties.AutomationId="Connect" />
        </StackPanel>
        <StackPanel Orientation="Horizontal"><TextBlock Text="⠿" Foreground="{StaticResource Accent}" FontSize="30" Margin="0,0,12,0" /><TextBlock Text="LED Panel Editor" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="40,26,40,24" MaxWidth="1000">
        <DockPanel Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="↑" Command="{Binding MoveUpCommand}" Style="{StaticResource Quiet}" AutomationProperties.Name="Move selected message earlier" />
            <Button Content="↓" Command="{Binding MoveDownCommand}" Style="{StaticResource Quiet}" AutomationProperties.Name="Move selected message later" />
            <Button Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource Quiet}" Margin="5,0" />
            <Button Content="+ Message" Command="{Binding AddCommand}" Padding="10,6" AutomationProperties.AutomationId="AddMessage" />
          </StackPanel>
          <TextBlock Text="Messages" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="QueueList" ItemsSource="{Binding Messages}" SelectedItem="{Binding Selected}" IsEnabled="{Binding QueueEditable}" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,0,0,20" AlternationCount="20" AutomationProperties.Name="Message queue">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Margin" Value="0,0,8,4" /><Setter Property="Padding" Value="12,9" /><Setter Property="MinWidth" Value="100" /><Setter Property="MaxWidth" Value="230" />
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#CBD4DF" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Tab" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#E7EEF8" /><Setter TargetName="Tab" Property="BorderBrush" Value="#7595BD" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#285DA8" /></Trigger>
                <DataTrigger Binding="{Binding IsValid}" Value="False"><Setter TargetName="Tab" Property="BorderBrush" Value="#B32525" /></DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Margin="0,0,0,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="128 × 16" FontFamily="Consolas" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="Simulation" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" Style="{StaticResource Quiet}" Width="56" Padding="4" AutomationProperties.AutomationId="Play" />
          </StackPanel>
          <TextBlock Text="Display" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <Border Background="#161C21" BorderBrush="#34404B" BorderThickness="8" CornerRadius="8" Padding="12,15">
          <preview:LedPreview x:Name="DisplayPreview" AutomationProperties.Name="LED message simulation" />
        </Border>
        <DockPanel Margin="0,26,0,9">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Selected.Count}" Foreground="{StaticResource Muted}" FontSize="12" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding DirtyLabel}" Foreground="{StaticResource Muted}" Margin="12,0,16,0" FontSize="12" />
          <Label Content="Message" Target="{Binding ElementName=MessageText}" FontWeight="SemiBold" />
        </DockPanel>
        <TextBox x:Name="MessageText" Text="{Binding Selected.Text, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}" Height="100" MaxLength="800"
                 FontSize="17" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.AutomationId="MessageText" />
        <TextBlock Text="{Binding Selected.Error}" Foreground="#B32525" MinHeight="22" FontSize="12" Margin="0,4,0,0" />
        <Grid IsEnabled="{Binding HasSelection}" Margin="0,4,0,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Label Content="Layout" Target="{Binding ElementName=LayoutChoice}" />
          <ComboBox x:Name="LayoutChoice" Grid.Column="1" ItemsSource="{Binding Layouts}" SelectedValue="{Binding Selected.Layout}" AutomationProperties.AutomationId="Layout" />
          <TextBlock Grid.Column="2" Text="{Binding Selected.LayoutHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" />
        </Grid>
        <Grid IsEnabled="{Binding HasSelection}" Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Appearance" FontWeight="SemiBold" Foreground="#536277" Margin="0,0,0,16" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="85" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="36" /></Grid.RowDefinitions>
              <Label Content="Color" Target="{Binding ElementName=ColorChoice}" /><ComboBox x:Name="ColorChoice" Grid.Column="1" ItemsSource="{Binding Colors}" SelectedValue="{Binding Selected.Color}" Margin="0,0,0,12" />
              <Label Grid.Row="1" Content="Font" Target="{Binding ElementName=FontChoice}" /><ComboBox x:Name="FontChoice" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Fonts}" SelectedValue="{Binding Selected.Font}" Margin="0,0,0,12" />
              <Label Grid.Row="2" Content="Alignment" Target="{Binding ElementName=AlignChoice}" /><ComboBox x:Name="AlignChoice" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Alignments}" SelectedValue="{Binding Selected.Align}" IsEnabled="{Binding Selected.EffectsEnabled}" Margin="0,0,0,12" />
              <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Flash text" IsChecked="{Binding Selected.Flash}" IsEnabled="{Binding Selected.EffectsEnabled}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
          <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" HorizontalAlignment="Center" />
          <StackPanel Grid.Column="2">
            <TextBlock Text="Motion" FontWeight="SemiBold" Foreground="#536277" Margin="0,0,0,16" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="85" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="44" /></Grid.RowDefinitions>
              <Label Content="Entry" Target="{Binding ElementName=EntryChoice}" />
              <ComboBox x:Name="EntryChoice" Grid.Column="1" ItemsSource="{Binding Effects}" SelectedValue="{Binding Selected.Entry}" Margin="0,0,0,12">
                <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled"><Setter.Value>
                  <MultiBinding Converter="{StaticResource EntryEnabled}"><Binding Path="Key" /><Binding Path="DataContext.Selected.Overflow" RelativeSource="{RelativeSource AncestorType=ComboBox}" /></MultiBinding>
                </Setter.Value></Setter></Style></ComboBox.ItemContainerStyle>
              </ComboBox>
              <Label Grid.Row="1" Content="Exit" Target="{Binding ElementName=ExitChoice}" /><ComboBox x:Name="ExitChoice" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Effects}" SelectedValue="{Binding Selected.Exit}" IsEnabled="{Binding Selected.EffectsEnabled}" Margin="0,0,0,12" />
              <Label Grid.Row="2" Content="Pause" Target="{Binding ElementName=PauseText}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox x:Name="PauseText" Text="{Binding Selected.PauseText, UpdateSourceTrigger=PropertyChanged}" Width="76" IsEnabled="{Binding Selected.EffectsEnabled}" AutomationProperties.Name="Pause in seconds" />
                <TextBlock Text="seconds" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <Label Grid.Row="3" Content="Speed" Target="{Binding ElementName=SpeedSlider}" />
              <StackPanel Grid.Row="3" Grid.Column="1">
                <Slider x:Name="SpeedSlider" Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Selected.Speed}" AutomationProperties.Name="Animation speed" />
                <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Fast" FontSize="10" Foreground="{StaticResource Muted}" /><TextBlock DockPanel.Dock="Right" Text="Slow" FontSize="10" Foreground="{StaticResource Muted}" /><TextBlock Text="{Binding Selected.SpeedLabel}" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource Muted}" /></DockPanel>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,20,0,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border CornerRadius="5" Padding="13,11" Margin="0,0,10,0">
              <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E9EEF4" /><Style.Triggers><DataTrigger Binding="{Binding FeedbackError}" Value="True"><Setter Property="Background" Value="#FBEAEA" /></DataTrigger></Style.Triggers></Style></Border.Style>
              <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="Feedback" />
            </Border>
            <Button Grid.Column="1" Content="Restore original" Command="{Binding RestoreCommand}" Style="{StaticResource Quiet}" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Restore" />
            <Button Grid.Column="2" Command="{Binding PreviewCommand}" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Preview"><StackPanel Orientation="Horizontal"><TextBlock Text="Preview" /><TextBlock Text="30 sec" FontSize="11" Opacity="0.65" Margin="8,2,0,0" /></StackPanel></Button>
            <Button Grid.Column="3" Content="Upload" Command="{Binding UploadCommand}" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" VerticalAlignment="Center" AutomationProperties.AutomationId="Upload" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
